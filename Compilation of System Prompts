def POSTSOLVE(line):
    """
    Processes a hooked line of text to format it for the LLM.
    Handles dialogue lines with speaker names and plain narration.
    """
    # CORRECTED PATTERN: Now looks for 」Name instead of 」「Name
    pattern = r"^(?:「)(.*)」(.+)$"

    match = re.search(pattern, line.strip())

    if match:
        # --- It's a dialogue line ---
        dialogue_content = match.group(1).strip()
        character_name = match.group(2).strip()

        # Look up the character in our database
        char_data = CHARACTERS_DB.get(character_name)

        if char_data:
            en_name = char_data.get('name', '')
            gender = char_data.get('gender', '')
            return f"[{en_name}|{character_name}|{gender}] {dialogue_content}"
        else:
            return f"[{character_name}] {dialogue_content}"

    elif line.strip():
        # --- It's a narration line (or a split dialogue fragment) ---
        return f"[Narration] {line.strip()}"
    
    else:
        # --- It's an empty line ---
        return line

